@using Dmat.Web.Models.Entities
@using Dmat.Web.Services
@model PatientPage
@{
    ViewData["Title"] = "傷患清單";
    var f = Model.Filter;

    string TriageChar(TriageLevel t) => (byte)t switch
    {
        1 => "紅", 2 => "黃", 3 => "綠", 4 => "黑", 5 => "緩", _ => "?",
    };
}

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <h4 class="mb-0">傷患清單</h4>
    <span class="text-muted small">
        @(f.HasAnyFilter ? "符合條件" : "共") <b>@Model.TotalCount</b> 人
        @if (Model.PageCount > 1)
        {
            <text>・第 @Model.CurrentPage / @Model.PageCount 頁</text>
        }
    </span>
</div>

@* 篩選列。手機上每個控制項佔滿整行方便單手點選,桌機則並排成一列。 *@
<form method="get" class="card card-body py-2 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label small mb-1" for="q">傷票編號 / 姓名</label>
            <input type="search" class="form-control" id="q" name="q" value="@f.Keyword"
                   placeholder="輸入部分即可,如 SIM 或 陳" autocomplete="off" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-1" for="triage">檢傷分類</label>
            <select class="form-select" id="triage" name="triage">
                <option value="">全部</option>
                @foreach (var t in Enum.GetValues<TriageLevel>())
                {
                    <option value="@((byte)t)" selected="@(f.Triage == t)">@PatientCareService.TriageName(t)</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-1" for="status">動向</label>
            <select class="form-select" id="status" name="status">
                <option value="">全部</option>
                @foreach (var s in Enum.GetValues<PatientStatus>())
                {
                    <option value="@((byte)s)" selected="@(f.Status == s)">@PatientCareService.StatusLabel(s)</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">篩選</button>
            @if (f.HasAnyFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="清除所有條件">✕</a>
            }
        </div>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-secondary">
        @(f.HasAnyFilter ? "沒有符合條件的傷患。請放寬條件或清除篩選。" : "目前沒有任何傷患資料。")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover bg-white align-middle">
            <thead>
            <tr><th>檢傷</th><th>傷票編號</th><th>姓名</th><th>性別</th><th>年齡</th><th>動向</th><th>更新時間</th></tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Items)
            {
                <tr style="cursor:pointer" onclick="location='@Url.Action("Detail", new { id = p.PatientId })'">
                    <td><span class="triage-badge triage-@((byte)p.CurrentTriage)">@TriageChar(p.CurrentTriage)</span></td>
                    <td class="fw-bold">@(p.TagNo ?? "—")</td>
                    <td>@(p.Name ?? "(無名氏)")</td>
                    <td>@(p.Gender switch { Gender.Male => "男", Gender.Female => "女", Gender.Other => "其他", _ => "—" })</td>
                    <td>@(p.EstAge?.ToString() ?? "—")</td>
                    <td>@PatientCareService.StatusLabel(p.Status)</td>
                    <td class="small text-muted">@p.UpdatedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @* 分頁連結必須帶著目前的篩選條件 ——
       否則翻到第 2 頁會變成全部傷患,使用者看到的清單與剛才不是同一份。 *@
    @if (Model.PageCount > 1)
    {
        <nav class="d-flex justify-content-between align-items-center">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-outline-secondary" asp-action="Index"
                   asp-route-q="@f.Keyword" asp-route-triage="@f.Triage" asp-route-status="@f.Status"
                   asp-route-page="@(Model.CurrentPage - 1)">← 上一頁</a>
            }
            else
            {
                <span></span>
            }
            <span class="text-muted small">第 @Model.CurrentPage / @Model.PageCount 頁</span>
            @if (Model.HasNext)
            {
                <a class="btn btn-outline-secondary" asp-action="Index"
                   asp-route-q="@f.Keyword" asp-route-triage="@f.Triage" asp-route-status="@f.Status"
                   asp-route-page="@(Model.CurrentPage + 1)">下一頁 →</a>
            }
            else
            {
                <span></span>
            }
        </nav>
    }
}

<p class="text-muted small mt-2 mb-0">
    清單依<b>檢傷分類</b>排序(紅→黃→綠→黑→緩),同級再依最近更新 ——
    優先呈現接下來最需要處理的傷患。
</p>
