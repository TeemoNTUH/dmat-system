{
  "Urls": "http://localhost:5100",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // 資料庫提供者切換(架構書 6.3):Sqlite / SqlServer,程式碼不需修改
  "Database": {
    "Provider": "Sqlite",
    "ConnectionStrings": {
      "Sqlite": "Data Source=./app_data/dmat.db;Cache=Shared",
      "SqlServer": "Server=.;Database=DMAT;Trusted_Connection=True;Encrypt=True"
    }
  },

  // AI 辨識服務(架構書 5.1:同機或同區網之獨立服務程序)
  // TimeoutSeconds:GB10 上 Chandra OCR 2 兩階段辨識整頁紀錄單實測約 150~300 秒
  // (2026-11-06 紀錄),300 秒常不夠而逾時,故放寬為 600 秒。mock 引擎僅需 1 秒。
  "AiService": {
    "BaseUrl": "http://localhost:8100",
    "TimeoutSeconds": 600,
    // Concurrency:同時送幾張給 AI 服務(vLLM 會合併批次處理)。1 = 逐一處理。
    // 2026-11-06 起試跑 3;調整後請看日誌「辨識耗時」確認單張沒有逼近 TimeoutSeconds。
    "Concurrency": 3
  },

  // 信心分數門檻:低於門檻之欄位強制進入人工覆核(架構書 4.1)
  // 必填欄位(檢傷分類、性別、傷票編號)與高敏感欄位採較高門檻
  "Ocr": {
    "DefaultConfidenceThreshold": 0.85,
    "FieldThresholds": {
      "triage": 0.95,
      "gender": 0.9,
      "patient_tag_id": 0.95,
      "national_id": 0.95
    }
  },

  "ImageStorage": {
    "Root": "./app_data/images"
  }
}
