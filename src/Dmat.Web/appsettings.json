{
  "Urls": "http://localhost:5100",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // 資料庫提供者切換(架構書 6.3):Sqlite / SqlServer,程式碼不需修改
  "Database": {
    "Provider": "Sqlite",
    "ConnectionStrings": {
      "Sqlite": "Data Source=./app_data/dmat.db;Cache=Shared",
      "SqlServer": "Server=.;Database=DMAT;Trusted_Connection=True;Encrypt=True"
    }
  },

  // AI 辨識服務(架構書 5.1:同機或同區網之獨立服務程序)
  // TimeoutSeconds:真實視覺模型辨識整頁紀錄單約需 30~90 秒(本機推論更久,
  // 且首次請求可能還在載入模型),故留 300 秒。mock 引擎僅需 1 秒。
  "AiService": {
    "BaseUrl": "http://localhost:8100",
    "TimeoutSeconds": 300
  },

  // 信心分數門檻:低於門檻之欄位強制進入人工覆核(架構書 4.1)
  // 必填欄位(檢傷分類、性別、傷票編號)與高敏感欄位採較高門檻
  "Ocr": {
    "DefaultConfidenceThreshold": 0.85,
    "FieldThresholds": {
      "triage": 0.95,
      "gender": 0.9,
      "patient_tag_id": 0.95,
      "national_id": 0.95
    }
  },

  "ImageStorage": {
    "Root": "./app_data/images"
  }
}
